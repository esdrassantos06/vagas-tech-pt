    "/subscriptions": {
      "post": {
        "description": "Create a job alert and return its `manage_token` once.\n\n- **email**: `target` is your address; a confirmation link is emailed.\n- **discord**: `target` is a channel webhook URL; the link is posted there.\n- **telegram**: omit `target`, open the returned `deep_link` and press Start.\n\nAlerts are only sent after confirmation. Empty filters match every job.",
        "operationId": "create_subscription_subscriptions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionCreated"
                }
              }
            },
            "description": "Successful Response"
          },
